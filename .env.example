# ==============================================================================
# Scriptloom API – Environment Variables Configuration Template
# Copy this file to '.env' and fill in your local development configuration.
# DO NOT commit the '.env' file containing real secrets to version control.
# ==============================================================================

# --- Backend Application Configuration ---
APP_NAME=Scriptloom API
APP_VERSION=1.0.0
DEBUG=True

# --- Database Connection ---
# Example SQLite: sqlite:///./scriptloom.db
# Example PostgreSQL: postgresql+psycopg://postgres:password@localhost:5432/scriptloom
DATABASE_URL=sqlite:///./scriptloom.db

# --- Security & JWT Authentication ---
# Generate a secure random key in Python: secrets.token_hex(32)
SECRET_KEY=generate_and_insert_a_long_random_secure_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS Allowed Origins ---
# Comma-separated list of origins allowed to access the API (no wildcard '*' allowed with credentials)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- Cache & Background Workers ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Third-Party Integrations & API Keys ---
# Required for AI features and content selection
GEMINI_API_KEY=insert_your_google_gemini_api_key_here

# Required for Google ID Token verification on the backend
GOOGLE_CLIENT_ID=insert_your_google_oauth_client_id_here

# Optional: OpenAI API Key (if OpenAI services are configured)
OPENAI_API_KEY=

# --- Media Processing & STT Paths ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_MODEL=base
MEDIA_FOLDER=storage/media
OUTPUT_FOLDER=storage/output

# --- Frontend Application (Vite Environment Variables) ---
# Set to change the API endpoint or Google Client ID client-side
VITE_API_URL=/api/v1
VITE_APP_URL=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=insert_your_google_oauth_client_id_here

# --- Storage Backend Configuration ---
# Options: local | r2
# If R2 credentials are incomplete, the app falls back to Local Storage
# with a warning instead of failing to start.
STORAGE_BACKEND=local
# Required for local backend
LOCAL_STORAGE_ROOT=media

# --- Cloudflare R2 Configuration ---
# Only required when STORAGE_BACKEND=r2. Credentials must never be committed.
R2_ACCOUNT_ID=
# S3-compatible endpoint. May be omitted when R2_ACCOUNT_ID is set (the
# standard endpoint is derived). R2_ENDPOINT_URL is accepted as a legacy alias.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public base URL for direct asset access (R2 Public Bucket / custom domain)
R2_PUBLIC_URL=

# --- Webhook Reliability Configuration ---
WEBHOOK_TIMEOUT=5.0
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=60
WEBHOOK_RECOVERY_TIMEOUT=300

# --- Email (Password Reset) Configuration ---
# Generic SMTP. Leave SMTP_HOST empty to disable email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Scriptloom
SMTP_USE_TLS=true

# Public frontend URL used to build password-reset links in emails
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=10


