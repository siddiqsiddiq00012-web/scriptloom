# ==============================================================================
# Scriptloom API – Environment Variables Configuration Template
# Copy this file to '.env' and fill in your local development configuration.
# DO NOT commit the '.env' file containing real secrets to version control.
# ==============================================================================

# --- Backend Application Configuration ---
APP_NAME=Scriptloom API
APP_VERSION=1.0.0
DEBUG=True

# --- Database Connection ---
# Example SQLite: sqlite:///./scriptloom.db
# Example PostgreSQL: postgresql+psycopg://postgres:password@localhost:5432/scriptloom
DATABASE_URL=sqlite:///./scriptloom.db

# --- Security & JWT Authentication ---
# Generate a secure random key in Python: secrets.token_hex(32)
SECRET_KEY=generate_and_insert_a_long_random_secure_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Cache & Background Workers ---
REDIS_URL=redis://localhost:6379/0

# --- Third-Party Integrations & API Keys ---
# Required for AI features and content selection
GEMINI_API_KEY=insert_your_google_gemini_api_key_here

# Required for Google ID Token verification on the backend
GOOGLE_CLIENT_ID=insert_your_google_oauth_client_id_here

# Optional: OpenAI API Key (if OpenAI services are configured)
OPENAI_API_KEY=

# --- Media Processing & STT Paths ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_MODEL=base
MEDIA_FOLDER=storage/media
OUTPUT_FOLDER=storage/output

# --- Frontend Application (Vite Environment Variables) ---
# Set to change the API endpoint or Google Client ID client-side
VITE_API_URL=/api/v1
VITE_APP_URL=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=insert_your_google_oauth_client_id_here
